---
import { site } from '../data/site';

const nextURL = new URL('/contact/merci/', Astro.site);
---

<div class="card contact-form-card">
  <form action={`https://formsubmit.co/${site.email}`} method="POST">
    <input type="hidden" name="_subject" value={`Nouvelle demande de devis — ${site.name}`} />
    <input type="hidden" name="_captcha" value="false" />
    <input type="hidden" name="_template" value="table" />
    <input type="hidden" name="_next" value={nextURL.toString()} />
    <input type="text" name="_honey" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />

    <div class="form-group">
      <label for="name">Nom complet</label>
      <input class="form-input" type="text" id="name" name="Nom" placeholder="Votre nom" required />
    </div>
    <div class="form-group">
      <label for="phone">Téléphone</label>
      <input class="form-input" type="tel" id="phone" name="Telephone" placeholder={site.phone} required />
    </div>
    <div class="form-group">
      <label for="email">Email</label>
      <input class="form-input" type="email" id="email" name="Email" placeholder="votre@email.com" required />
    </div>
    <div class="form-group">
      <label for="service">Type d'intervention</label>
      <select class="form-input" id="service" name="Type d'intervention">
        <option>Nettoyage / démoussage de toiture</option>
        <option>Pose de gouttières</option>
        <option>Rénovation de toiture</option>
        <option>Faîtage / charpente / étanchéité</option>
        <option>Urgence fuite / bâchage</option>
        <option>Autre demande</option>
      </select>
    </div>
    <div class="form-group">
      <label for="message">Votre message</label>
      <textarea class="form-input" id="message" name="Message" rows="4" placeholder="Précisez votre demande..." required></textarea>
    </div>

    <button type="submit" class="btn btn--primary btn-submit">Envoyer ma demande</button>
  </form>
</div>

<style>
  .contact-form-card {
    padding: var(--card-pad);
  }

  .form-group {
    margin-bottom: 1.25rem;
  }

  .form-group label {
    display: block;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .form-input {
    width: 100%;
    min-height: var(--tap);
    background: #f5f6f9;
    border: 1px solid var(--glass-border);
    border-radius: 16px;
    padding: 0.85rem 1.1rem;
    color: var(--text-main);
    font-family: var(--font-sans);
    /* 16px minimum : en dessous, Safari iOS zoome à la mise au point du champ */
    font-size: 1rem;
    transition: var(--transition);
  }

  select.form-input {
    appearance: none;
    background-image: url("data:image/svg+xml;charset=utf-8,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%236d5f52' stroke-width='2'%3E%3Cpath d='M6 9l6 6 6-6'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 1rem center;
    background-size: 18px;
    padding-right: 2.75rem;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--accent);
    background: #ffffff;
    box-shadow: 0 0 0 4px rgba(var(--accent-rgb), 0.1);
  }

  textarea.form-input {
    resize: vertical;
    font-family: var(--font-sans);
  }

  .btn-submit {
    width: 100%;
    justify-content: center;
  }
</style>
