---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, cities, cityZones, socials, testimonials } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  image?: string;
  noindex?: boolean;
  breadcrumbs?: { name: string; path: string }[];
  /**
   * Sort le header du flux pour que la première section démarre en haut de
   * page, le header flottant par-dessus. Réservé aux pages dont la section
   * d'ouverture a un fond à elle (le héros photo de l'accueil) et assez de
   * marge haute pour passer sous le header — sinon le contenu s'y glisse
   * dessous et devient illisible.
   */
  heroFlush?: boolean;
}

const { title, description, jsonLd, image = '/images/hero/banniere-toiture.jpg', noindex = false, breadcrumbs, heroFlush = false } = Astro.props;
const ogImageURL = new URL(image, Astro.site);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = Astro.site?.toString().replace(/\/$/, '') ?? '';
const pageTitle = title.includes(site.name) ? title : `${title} | ${site.name}`;

// Convertit "mai 2026" / "déc. 2025" en "2026-05" pour Review.datePublished (schema.org)
const MOIS: Record<string, string> = {
  janv: '01', fév: '02', févr: '02', mars: '03', avr: '04', mai: '05', juin: '06',
  juil: '07', août: '08', sept: '09', oct: '10', nov: '11', déc: '12',
};
const toIsoMonth = (frDate: string) => {
  const [moisRaw, annee] = frDate.replace('.', '').trim().split(/\s+/);
  const cle = moisRaw.toLowerCase();
  const mois = MOIS[cle] ?? Object.entries(MOIS).find(([k]) => cle.startsWith(k))?.[1];
  return mois ? `${annee}-${mois}` : annee;
};

// Avis réellement affichés sur la page (section Testimonials) : un aggregateRating
// doit être adossé à des avis consultables sur le site pour rester conforme aux
// règles de Google sur les extraits d'avis.
const reviewLd = testimonials.map((t) => ({
  '@type': 'Review',
  author: { '@type': 'Person', name: t.name },
  datePublished: toIsoMonth(t.date),
  reviewBody: t.text,
  reviewRating: { '@type': 'Rating', ratingValue: 5, bestRating: 5, worstRating: 1 },
}));

// Zones desservies : départements (AdministrativeArea) + communes (City) pour un maillage local riche
const areaServed = [
  ...cityZones.map((z) => ({
    '@type': 'AdministrativeArea',
    name: `${z.department} (${z.code})`,
  })),
  ...cities.map((c) => ({ '@type': 'City', name: c })),
];

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'RoofingContractor',
  '@id': `${siteURL}/#business`,
  name: site.name,
  legalName: `${site.name} — ${site.owner}`,
  description: site.description,
  image: ogImageURL.toString(),
  logo: `${siteURL}/images/logo-mark.png`,
  url: siteURL,
  telephone: site.phone,
  email: site.email,
  priceRange: site.priceRange,
  foundingDate: site.foundingDate,
  areaServed,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.streetAddress,
    addressLocality: `${site.baseCity}-sur-Oise`,
    postalCode: site.basePostalCode,
    addressRegion: site.region,
    addressCountry: 'FR',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: site.latitude,
    longitude: site.longitude,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: site.openTime,
    closes: site.closeTime,
  },
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: site.rating,
    reviewCount: site.reviewCount,
    bestRating: 5,
    worstRating: 1,
  },
  review: reviewLd,
  sameAs: [site.alloVoisinsUrl, ...socials.map((s) => s.url)],
};

const breadcrumbLd = breadcrumbs
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteURL}/` },
        ...breadcrumbs.map((b, i) => ({
          '@type': 'ListItem',
          position: i + 2,
          name: b.name,
          item: `${siteURL}${b.path}`,
        })),
      ],
    }
  : null;

const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const structuredData = [defaultJsonLd, ...(breadcrumbLd ? [breadcrumbLd] : []), ...extra];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/inter-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/fraunces-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="canonical" href={canonicalURL} />
    <meta name="google-site-verification" content="B1WkgeZxxPJN1plooz2pAMx1I3kVFwDt3Zf2duJ3hLc" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <meta name="geo.placename" content={`${site.baseCity}, Val d'Oise`} />
    <meta name="theme-color" content="#f5f5f7" />

    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    {structuredData.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
    ))}
  </head>
  <body class={heroFlush ? 'hero-flush' : undefined}>
    <div class="ambient-glow-1"></div>
    <div class="ambient-glow-2"></div>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <a class="mobile-call-bar" href={site.phoneHref}>
      📞 Appeler {site.phone}
    </a>

    <script>
      const sections = Array.from(document.querySelectorAll('main section'));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduceMotion || !('IntersectionObserver' in window)) {
        sections.forEach((s) => s.classList.add('is-visible'));
      } else {
        const reveal = (s: Element) => s.classList.add('is-visible');

        // Révèle toute section déjà dans le viewport OU au-dessus (cas des ancres profondes /#avis)
        const revealAbove = () => {
          sections.forEach((s) => {
            if (!s.classList.contains('is-visible') && s.getBoundingClientRect().top < window.innerHeight) {
              reveal(s);
            }
          });
        };

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                reveal(entry.target);
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0, rootMargin: '0px 0px -8% 0px' }
        );
        sections.forEach((s) => observer.observe(s));

        revealAbove();
        window.addEventListener('load', revealAbove);
        window.addEventListener('hashchange', revealAbove);
        setTimeout(revealAbove, 400);
      }
    </script>
  </body>
</html>
